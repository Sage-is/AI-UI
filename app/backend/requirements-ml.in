# ML packages installed at runtime via the Search & Audio wizard step.
# These are NOT baked into the base Docker image to keep it slim (~1.5GB).
# The wizard caches wheels on the data volume for fast re-install on restart.
#
# This file is the declarative INPUT. The committed `requirements-ml.lock`
# (generated by `uv pip compile --generate-hashes`) is what the wizard
# actually installs from. Regenerate the lock when you edit this file, in the
# image and from the current lock, moving only the packages you name:
#
#   make ml_lock UPGRADE="sentence-transformers"
#
# The lock carries its index lines, so the wizard installs torch from the
# CPU index below. A lock compiled on a Mac without them made the Linux
# install pull 19 unpinned CUDA packages from PyPI (found 2026-11-03).

# 5.6.0 fixes CVE-2026-68770 (critical) and drops pillow from the closure.
sentence-transformers==5.6.0
# >=4.47.0 dropped the huggingface-hub<1.0 constraint; sentence-transformers
# 4.1.0 pulls hub 1.x, so transformers must agree.
transformers>=4.47.0,<5.0
# transformers in the 4.47.x range hard-requires tokenizers<=0.23.0; without
# this explicit bound pip's resolver picks 0.23.1 (the latest available) and
# transformers refuses to import. Discovered 2026-05-12 during 2.3.1 verify.
tokenizers>=0.22.0,<=0.23.0
colbert-ai==0.2.21

faster-whisper==1.1.1
ctranslate2
onnxruntime==1.20.1

# torch from the PyTorch CPU-only index — avoids dragging the CUDA wheels
# (nvidia-cusolver, nvidia-cublas, nvidia-cudnn, ...) that the default PyPI
# wheel pulls and which add ~5GB of unused runtime to ml_packages. CUDA is
# handled by the 2.4 bundle matrix as a separate per-accel artifact, not
# by this lockfile.
--extra-index-url https://download.pytorch.org/whl/cpu
torch>=2.2,<3
# numpy 2.x's ABI break still bites a handful of ML wheels in our closure.
# Cap at <2 for 2.3.1; revisit when the 2.4 bundle builds against a single
# pinned numpy.
numpy<2

scipy
scikit-learn
