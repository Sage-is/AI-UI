#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# Canonical distribution facts.
# ---------------------------------------------------------------------------
# These mirror values in distribution.env, which pins the server version this
# CLI ships with. The CLI lives in AI-UI's cli/ folder and ships inside each
# AI-UI release, so the file sits one folder up in a checkout and beside the
# script in a brew install. The defaults below apply only when it is absent.

IMAGE_REGISTRY="ghcr.io/sage-is/ai-ui"
DEFAULT_SERVER_TAG="latest"
CONTAINER="sage-ai"
VOLUME="sage-ai-data"
DATA_MOUNT="/app/backend/data"
DEFAULT_PORT=8080

# The CLI's own files sit beside it. A link to it, such as one in ~/bin, leads there.
here="${BASH_SOURCE[0]}"
while [[ -L "$here" ]]; do
  target="$(readlink "$here")"
  if [[ "$target" == /* ]]; then here="$target"; else here="$(dirname "$here")/$target"; fi
done
here="$(cd "$(dirname "$here")" && pwd)"
for _env in "$here/distribution.env" "$here/../distribution.env"; do
  if [[ -f "$_env" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$_env"
    set +a
    IMAGE_REGISTRY="${IMAGE:-$IMAGE_REGISTRY}"
    DEFAULT_SERVER_TAG="${SERVER_TAG:-$DEFAULT_SERVER_TAG}"
    VOLUME="${VOLUME:-$VOLUME}"
    DATA_MOUNT="${DATA_MOUNT:-$DATA_MOUNT}"
    break
  fi
done
# The data volume, or a folder for it. Read after distribution.env, which sets
# VOLUME itself and would overwrite a plain VOLUME from the environment.
VOLUME="${SAGE_AI_VOLUME:-$VOLUME}"

# The runtime code ai-ui shares with sage-runtime and trellis-crm: a copy of
# the homebrew-apps tap's lib/sage-runtime.sh, made by `make runtime_sync`.
[[ -f "$here/lib/sage-runtime.sh" ]] || { echo "Error: $here/lib/sage-runtime.sh is missing. Reinstall ai-ui (brew reinstall ai-ui), or in an AI-UI checkout run: make runtime_sync" >&2; exit 1; }
# shellcheck source=lib/sage-runtime.sh
source "$here/lib/sage-runtime.sh"
trap_cleanup
# The lib's cleanup, then Sage back up where a move stopped it (restart_sage).
trap 'cleanup; restart_sage' EXIT
# Its messages name ai-ui's own commands.
USE_COMMAND="ai-ui start --runtime"
CONVERT_COMMAND="ai-ui migrate"

# One version number: the CLI's version is the AI-UI server version it pins.
VERSION="$DEFAULT_SERVER_TAG"

# Active image tag. Overridable per-invocation via `--tag X.Y.Z`.
IMAGE_TAG="$DEFAULT_SERVER_TAG"
IMAGE="$IMAGE_REGISTRY:$IMAGE_TAG"

# try.sage trial mode runs the same image with ENABLE_TRY_SAGE=true. Separate
# container + volume so a workstation can keep its prod install around without
# data cross-contamination — though both bind 8080, so only one runs at a time.
TRY_CONTAINER="sage-try"
TRY_VOLUME="sage-try-data"

# The image's Ollama default is http://host.docker.internal:11434. Containers
# reach this machine by that name on every runtime with this flag: Colima
# resolves it only through Lima's DNS, and Linux not at all. host-gateway is
# the machine's address as the engine sees it (192.168.5.2 in a Colima VM).
HOST_ENTRY="--add-host=host.docker.internal:host-gateway"

# ---------------------------------------------------------------------------
# Sage project registry (~/.sage-is/)
# Remembers where you cloned things so you never lose your code.
# ---------------------------------------------------------------------------
SAGE_PROJECTS="${SAGE_CONFIG_DIR}/projects"
TRY_ENV_FILE="${SAGE_CONFIG_DIR}/try.env"

# The upstream remote URL pattern (matches any protocol/suffix).
AI_UI_REMOTE="Sage-is/AI-UI"

# Read saved clone path for a project. Prints nothing if unset.
sage_project_dir() {
  [[ -f "$SAGE_PROJECTS" ]] && sed -n "s/^${1}=//p" "$SAGE_PROJECTS"
}

# Save (or update) the clone path for a project.
sage_set_project_dir() {
  local project="$1" dir="$2"
  mkdir -p "$SAGE_CONFIG_DIR"
  # Remove existing entry, then append. sed -i.bak for macOS compat.
  if [[ -f "$SAGE_PROJECTS" ]]; then
    sed -i.bak "/^${project}=/d" "$SAGE_PROJECTS" && rm -f "${SAGE_PROJECTS}.bak"
  fi
  echo "${project}=${dir}" >> "$SAGE_PROJECTS"
}

# Check if a directory is a clone of a given repo (by git remote, not folder name).
is_repo_for() {
  local dir="$1" pattern="$2"
  [[ -d "$dir/.git" ]] && git -C "$dir" remote -v 2>/dev/null | grep -qi "$pattern"
}

# Find a matching repo nearby: check cwd (walk up to git root), then scan subdirs.
# Detects by content (git remote), not directory name — works with any folder name.
find_repo_nearby() {
  local pattern="$1"

  # Are we already inside a matching repo?
  local git_root
  git_root="$(git rev-parse --show-toplevel 2>/dev/null)" || true
  if [[ -n "$git_root" ]] && is_repo_for "$git_root" "$pattern"; then
    echo "$git_root"; return 0
  fi

  # Scan immediate subdirectories (one level) for any matching clone.
  local subdir
  for subdir in ./*/; do
    [[ -d "$subdir/.git" ]] || continue
    if is_repo_for "$subdir" "$pattern"; then
      (cd "$subdir" && pwd); return 0
    fi
  done

  return 1
}

# Check if a path is ephemeral (won't survive reboot).
is_ephemeral_path() {
  case "$1" in
    /tmp/*|/private/tmp/*|/var/folders/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Colima shares only the home folder with containers: a folder elsewhere mounts empty.
in_home() {
  [[ "$1/" == "$HOME"/* ]]
}

usage() {
  cat <<EOF
Usage: ai-ui <command> [options]

Commands:
  start [--port PORT] [--tag X.Y.Z]
                        Pull image and start Sage AI UI (default port: $DEFAULT_PORT)
                        --tag pins a specific server version (default: $DEFAULT_SERVER_TAG)
  stop                  Stop the running container (prod and trial)
  try   [--port PORT] [--tag X.Y.Z]
                        Start try.sage trial mode (BYO Groq key on first run)
  update [--tag X.Y.Z]  Pull a tag (default latest) and restart
  dev   [--port PORT] [--dir DIR] [--where]
                        Clone and run in dev mode with hot reload. On Colima,
                        DIR must be in your home folder
  migrate [--dry-run]   Move Sage's data from Docker Desktop or OrbStack to
                        Colima, or make a vz Colima VM krunkit (macOS)
  logs                  Tail container logs
  open                  Open the UI in your default browser
  status                Show container status
  version               Show CLI version
  nuke  [--dry-run] [--all|--genesis]
                        Remove Sage AI UI for a clean slate (ai-ui nuke --help)

Every command also takes:
  --runtime NAME        macOS container runtime: colima (the default),
                        docker-desktop or orbstack. Remembered for next time.

On a Mac, start and update offer once to move Sage from Docker Desktop or
OrbStack to Colima, or from a vz Colima VM to krunkit. The answer is kept in
~/.sage-is/offers. ai-ui migrate moves Sage any time. It stops Sage, copies
sage-ai-data and sage-try-data through a file in ~/.sage-is/staging, and
counts the files on both sides. Then it starts Sage in Colima with the same
tag and port.
The old runtime keeps its copy: go back with --runtime docker-desktop or
--runtime orbstack. Other apps' data stays where it is; sage-runtime migrate
moves it all.

Colima's first start creates its VM; later starts keep it. On Apple Silicon,
install krunkit first: a krunkit VM gives memory Sage frees back to macOS.
  $KRUNKIT_INSTALL
Before ai-ui makes a krunkit VM, it adds two settings to Lima's override
file, which every Colima VM reads:
  $LIMA_OVERRIDE
"mountType: virtiofs" (abiosoft/colima#1607) forces virtiofs mounts, so a
QEMU Colima profile will not start while it is there. A boot step mounts the
VM's data disk, which krunkit leaves unmounted after its first boot
(abiosoft/colima#1614). Docker keeps its images and volumes there, Sage's
data among them: on a krunkit VM, colima ssh -- findmnt /var/lib/docker
shows /dev/vdc1. ai-ui stops while Docker runs on the VM's root disk
instead; colima restart puts it back once the step is in the file.

EOF
}

cmd_version() {
  echo "ai-ui $VERSION (server $DEFAULT_SERVER_TAG)"
}

# ---------------------------------------------------------------------------
# Container runtime
# ---------------------------------------------------------------------------
# On macOS Sage runs in Colima by default: no window, no sign-in, no licence
# screen. A Mac that already uses Docker Desktop or OrbStack may keep it. Each
# runtime keeps its own sage-ai-data volume, so the choice is saved and every
# command follows it. On Linux, Sage uses the Docker Engine as it is.
RUNTIME_FLAG=""
RUNTIME=""

# The first start on a Mac with more than one runtime asks which to use.
# The question goes to stderr; the answer is printed.
ask_runtime() {
  local default runtime answer="" installed=() n=0
  default="$(current_runtime)"
  runtime_installed "$default" || default=colima
  for runtime in $RUNTIMES; do
    if runtime_installed "$runtime"; then installed+=("$runtime"); fi
  done
  if [[ ${#installed[@]} -lt 2 || ! -t 0 ]]; then
    echo "$default"
    return
  fi

  {
    echo "Sage runs in a container runtime. This Mac has:"
    for runtime in "${installed[@]}"; do
      n=$((n + 1))
      echo "  $n) $runtime"
    done
    echo "Ran Sage here before? Pick the runtime you used: your data lives there."
    echo "ai-ui remembers the answer; switch later with --runtime NAME."
  } >&2
  read -rp "Runtime [$default]: " answer || true
  case "$answer" in
    "")    echo "$default" ;;
    [1-9]) echo "${installed[answer - 1]:-$answer}" ;;
    *)     echo "$answer" ;;
  esac
}

# Remembers RUNTIME for the commands that follow.
save_runtime() {
  mkdir -p "$SAGE_CONFIG_DIR"
  echo "$RUNTIME" > "$RUNTIME_FILE"
}

# Choose this command's runtime and point docker at it. `ask` (start, try,
# update, dev) saves the choice, asking on the first start; other commands follow it.
select_runtime() {
  if [[ -n "$RUNTIME_FLAG" ]]; then
    RUNTIME="$RUNTIME_FLAG"
  elif [[ ! -f "$RUNTIME_FILE" && "${1:-}" == ask ]]; then
    RUNTIME="$(ask_runtime)"
  else
    RUNTIME="$(current_runtime)"
  fi
  check_runtime "$RUNTIME"
  if [[ -n "$RUNTIME_FLAG" || "${1:-}" == ask ]]; then save_runtime; fi
  DOCKER_CONTEXT="$(runtime_context "$RUNTIME")"
  export DOCKER_CONTEXT
}

# Make sure the chosen runtime answers. On a Mac, docker's logins are mended
# first, then the runtime starts if it must; Colima's must keep Docker on the
# VM's data disk, however the VM came up. A Docker Desktop or OrbStack that is
# gone leaves Colima, which needs no app. Elsewhere, say how to start Docker.
ensure_docker() {
  if [[ "$(uname)" == Darwin ]]; then
    if [[ "$RUNTIME" != colima ]] && ! runtime_installed "$RUNTIME"; then
      die "$RUNTIME is not installed. Run Sage in Colima: ai-ui start --runtime colima. Or install it: $(runtime_install_command "$RUNTIME")"
    fi
    fix_credentials "$RUNTIME"
    start_runtime "$RUNTIME"
    return 0
  fi
  docker info &>/dev/null && return 0
  case "$(uname)" in
    Linux)
      if ! command -v docker &>/dev/null; then
        echo "Error: Docker is not installed."
        echo "  See: https://docs.docker.com/engine/install/"
        exit 1
      fi
      echo "Error: Docker daemon is not running."
      echo "  Start it with: sudo systemctl start docker"
      echo "  Enable on boot: sudo systemctl enable docker"
      exit 1
      ;;

    *)
      echo "Error: Cannot connect to Docker."
      exit 1
      ;;
  esac
}

cmd_start() {
  local port=$DEFAULT_PORT
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --tag)  IMAGE_TAG="$2"; IMAGE="$IMAGE_REGISTRY:$IMAGE_TAG"; shift 2 ;;
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done

  offer_colima
  ensure_docker

  echo "Pulling $IMAGE..."
  docker pull "$IMAGE"

  # Stop existing container if running
  docker rm -f "$CONTAINER" 2>/dev/null || true

  echo "Starting Sage AI UI on port $port..."
  docker run -d \
    -p "$port:8080" \
    "$HOST_ENTRY" \
    -v "$VOLUME:$DATA_MOUNT" \
    --name "$CONTAINER" \
    "$IMAGE"

  echo ""
  echo "Sage AI UI is running at http://localhost:$port"
  echo "Run 'ai-ui open' to open in your browser."
  moved_note
}

cmd_stop() {
  echo "Stopping Sage AI UI..."
  for c in "$CONTAINER" "$TRY_CONTAINER"; do
    docker stop "$c" 2>/dev/null || true
    docker rm "$c" 2>/dev/null || true
  done
  echo "Stopped."
}

cmd_dev() {
  local port=$DEFAULT_PORT
  local explicit_dir=""
  local repo_dir=""
  local saved
  saved="$(sage_project_dir ai-ui)" || true
  local needs_clone=false

  # --- Parse flags ---
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)  port="$2"; shift 2 ;;
      --dir)   explicit_dir="$2"; shift 2 ;;
      --where)
        # Quick lookup: where's my code?
        if [[ -n "$saved" ]]; then
          echo "$saved"
        else
          echo "No saved location yet. Run 'ai-ui dev' to set one up."
        fi
        return 0
        ;;
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done

  # --- Step 1: Explicit --dir? Trust the user. ---
  if [[ -n "$explicit_dir" ]]; then
    repo_dir="$explicit_dir"
    if [[ -n "$saved" && "$saved" != "$repo_dir" ]]; then
      echo "Note: switching from $saved (previously saved) to $repo_dir."
    fi

  # --- Step 2: SAGE_DEV_DIR env var? Backwards compat. ---
  elif [[ -n "${SAGE_DEV_DIR:-}" ]]; then
    repo_dir="$SAGE_DEV_DIR"
    if [[ -n "$saved" && "$saved" != "$repo_dir" ]]; then
      echo "Note: SAGE_DEV_DIR is set — switching from $saved to $repo_dir."
    fi

  # --- Step 3: Are we inside (or next to) an AI-UI repo right now? ---
  elif repo_dir="$(find_repo_nearby "$AI_UI_REMOTE")"; then
    if [[ -n "$saved" && "$saved" != "$repo_dir" ]]; then
      echo "Found AI-UI source here ($repo_dir)."
      echo "  Note: previously saved as $saved — updating."
    elif [[ -z "$saved" ]]; then
      echo "Found AI-UI source here ($repo_dir). Saving for next time."
    else
      echo "Using AI-UI source at $repo_dir"
    fi

  # --- Step 4: Do we have a saved path from last time? ---
  elif [[ -n "$saved" ]]; then
    if [[ -d "$saved" ]]; then
      echo "Using your AI-UI source at $saved (saved from last time)."
      repo_dir="$saved"
    else
      # The directory is gone — don't silently forget.
      echo "Heads up — your AI-UI source was at $saved, but that directory is gone."
      echo "  (If you moved it, you can point us there with: ai-ui dev --dir /new/path)"
      echo ""
      repo_dir="${HOME}/src/ai-ui"
      needs_clone=true
    fi

  # --- Step 5: First time, nothing found. Clone fresh. ---
  else
    repo_dir="${HOME}/src/ai-ui"
    needs_clone=true
  fi

  # --- Colima mounts only the home folder ---
  [[ "$repo_dir" == /* ]] || repo_dir="$PWD/$repo_dir"
  if [[ "$RUNTIME" == colima ]] && ! in_home "$repo_dir"; then
    die "$repo_dir is outside your home folder, the only one Colima shares with containers. Move it under $HOME, then: ai-ui dev --dir NEW_PATH"
  fi

  # --- Clone if needed ---
  if [[ "$needs_clone" == true ]] || [[ ! -d "$repo_dir" ]]; then
    echo "Cloning Sage AI UI to $repo_dir..."
    git clone https://github.com/Sage-is/AI-UI.git "$repo_dir"
    echo "  (We'll remember this location for next time.)"
  fi

  # --- Step 6: Ephemeral path warning ---
  if is_ephemeral_path "$repo_dir"; then
    echo ""
    echo "  ⚠ Heads up: $repo_dir may not survive a reboot."
    echo "    Your code changes could be lost."
    echo "    For a permanent location: ai-ui dev --dir ~/src/ai-ui"
    echo ""
  fi

  # --- Save the resolved path for next time ---
  sage_set_project_dir ai-ui "$repo_dir"

  # --- Start dev container ---
  ensure_docker

  docker rm -f "$CONTAINER" 2>/dev/null || true

  echo "Pulling latest image..."
  docker pull "$IMAGE"

  # File events from the Mac may never reach the container: the reloader polls.
  echo "Starting in dev mode on port $port..."
  docker run -d \
    -p "$port:8080" \
    -p 5173:5173 \
    "$HOST_ENTRY" \
    -v "$VOLUME:$DATA_MOUNT" \
    -v "$repo_dir/app/src:/app/src" \
    -v "$repo_dir/app/backend:/app/backend" \
    -v "$repo_dir/app/static:/app/static" \
    -e DEV_MODE=true \
    -e WATCHFILES_FORCE_POLLING=true \
    --name "$CONTAINER" \
    "$IMAGE"

  echo ""
  echo "Dev mode running. Source: $repo_dir"
  echo "App:      http://localhost:$port"
  echo "Vite HMR: http://localhost:5173 (when Node.js installed)"
  echo ""
  echo "Run 'ai-ui logs' to see output."
  echo "Run 'ai-ui open' to open in your browser."
}

# ---------------------------------------------------------------------------
# try.sage trial mode
# ---------------------------------------------------------------------------
# Bring up a trial container with seeded personas, hidden LLM connection, and
# 24h auto-reset. BYO Groq API key (saved chmod 600 to ~/.sage-is/try.env).
# Future: 'ai-ui login' will provide hosted free tokens after onboarding.

ensure_try_credentials() {
  mkdir -p "$SAGE_CONFIG_DIR"

  if [[ -f "$TRY_ENV_FILE" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$TRY_ENV_FILE"
    set +a
    if [[ -n "${TRY_SAGE_LLM_API_URL:-}" && -n "${TRY_SAGE_LLM_API_KEY:-}" ]]; then
      return 0
    fi
    echo "Found $TRY_ENV_FILE but it's missing required values. Re-prompting."
    echo ""
  fi

  cat <<EOF
try.sage needs an OpenAI-compatible LLM provider. We recommend Groq (fast, free tier):

  1. Sign up free at https://console.groq.com
  2. Create an API key at https://console.groq.com/keys
  3. Paste it below.

We'll save it to $TRY_ENV_FILE (chmod 600). Edit or delete that file to change it.

(Coming soon: 'ai-ui login' for hosted free tokens — no Groq account needed.)

EOF
  local key=""
  read -rp "Groq API key (starts with gsk_): " key
  if [[ -z "$key" ]]; then
    echo "No key provided. Aborting."
    exit 1
  fi

  cat > "$TRY_ENV_FILE" <<EOF
# Generated by 'ai-ui try'. Edit or delete this file to re-prompt.
TRY_SAGE_LLM_API_URL=https://api.groq.com/openai/v1
TRY_SAGE_LLM_API_KEY=$key
# Optional. Comma-separated whitelist of models. Empty = expose the full provider list.
TRY_SAGE_LLM_MODELS=
# Optional. Number of trial seats (personas). Default 3.
TRY_SAGE_USER_SEAT_COUNT=3
# Optional. Hours between auto-resets. Default 24.
TRY_SAGE_RESET_INTERVAL_HOURS=24
EOF
  chmod 600 "$TRY_ENV_FILE"
  echo "Saved to $TRY_ENV_FILE"
  echo ""

  set -a
  # shellcheck source=/dev/null
  source "$TRY_ENV_FILE"
  set +a
}

# Print the persona magic-link URLs for the running trial container.
print_try_links() {
  local port="$1"
  echo "Trial welcome URL: http://localhost:$port/auth (open in incognito)"
  echo ""
  echo "Persona magic-links:"
  curl -fsS "http://localhost:$port/api/v1/sage/runtime/personas" 2>/dev/null \
    | python3 -c "import json, sys; [print(f\"  {p['key']:12}  {p['login_url']}\") for p in json.load(sys.stdin)]" \
    || echo "  (container not yet responding on :$port — give it a moment, then re-run 'ai-ui try')"
}

cmd_try() {
  local port=$DEFAULT_PORT
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --tag)  IMAGE_TAG="$2"; IMAGE="$IMAGE_REGISTRY:$IMAGE_TAG"; shift 2 ;;
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done

  # Already running (e.g. backgrounded in another terminal)? Just print links.
  if docker inspect --format='{{.State.Status}}' "$TRY_CONTAINER" 2>/dev/null | grep -q running; then
    local existing_port
    existing_port=$(docker port "$TRY_CONTAINER" 8080 2>/dev/null | head -1 | cut -d: -f2)
    existing_port="${existing_port:-$port}"
    echo "try.sage is already running on port $existing_port."
    echo ""
    print_try_links "$existing_port"
    return 0
  fi

  ensure_try_credentials
  ensure_docker

  echo "Pulling latest image..."
  docker pull "$IMAGE"

  # Both prod and trial bind 8080 — drop whichever is in the way.
  docker rm -f "$CONTAINER" 2>/dev/null || true
  docker rm -f "$TRY_CONTAINER" 2>/dev/null || true

  local webui_url="${WEBUI_URL:-http://localhost:$port}"

  echo ""
  echo "Booting try.sage on $webui_url"
  echo "Magic links will print below once the runtime seeds personas."
  echo "Press Ctrl-C to stop."
  echo ""

  # Background poller waits for the API, prints persona links, then exits.
  # Decoupled from the foreground `docker run` so Ctrl-C cleanly tears down
  # the container (--rm) without us juggling pids.
  (
    for _ in $(seq 1 30); do
      if curl -fsS "http://localhost:$port/api/v1/sage/runtime/personas" >/dev/null 2>&1; then
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        print_try_links "$port"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        case "$(uname)" in
          Darwin) open "http://localhost:$port" ;;
          *)      xdg-open "http://localhost:$port" 2>/dev/null || true ;;
        esac
        exit 0
      fi
      sleep 1
    done
  ) &

  # Foreground run. Ctrl-C stops the container; --rm cleans the row.
  docker run --rm \
    -p "$port:8080" \
    "$HOST_ENTRY" \
    -v "$TRY_VOLUME:$DATA_MOUNT" \
    -e ENABLE_TRY_SAGE=true \
    -e WEBUI_URL="$webui_url" \
    -e TRY_SAGE_LLM_API_URL="$TRY_SAGE_LLM_API_URL" \
    -e TRY_SAGE_LLM_API_KEY="$TRY_SAGE_LLM_API_KEY" \
    -e TRY_SAGE_LLM_MODELS="${TRY_SAGE_LLM_MODELS:-}" \
    -e TRY_SAGE_USER_SEAT_COUNT="${TRY_SAGE_USER_SEAT_COUNT:-3}" \
    -e TRY_SAGE_RESET_INTERVAL_HOURS="${TRY_SAGE_RESET_INTERVAL_HOURS:-24}" \
    --name "$TRY_CONTAINER" \
    "$IMAGE"
}

# Nuke from orbit — delegates to the Genesis Device (standalone, works without ai-ui installed).
cmd_nuke() {
  if [[ -x "$here/nuke-sage" ]]; then
    exec "$here/nuke-sage" ai-ui "$@"
  else
    echo "Error: nuke-sage is not beside $here/ai-ui."
    exit 1
  fi
}

cmd_update() {
  # Pre-parse --tag so the pull line shows the right image; cmd_start re-parses.
  local i=0
  while [[ $i -lt $# ]]; do
    i=$((i + 1))
    if [[ "${!i:-}" == "--tag" ]]; then
      local next=$((i + 1))
      IMAGE_TAG="${!next}"
      IMAGE="$IMAGE_REGISTRY:$IMAGE_TAG"
      break
    fi
  done

  offer_colima
  ensure_docker
  echo "Pulling $IMAGE..."
  docker pull "$IMAGE"
  cmd_stop
  cmd_start "$@"
}

# ---------------------------------------------------------------------------
# Moving to Colima
# ---------------------------------------------------------------------------
# Docker Desktop and OrbStack hold on to memory Sage no longer uses, and so
# does a vz VM; a krunkit VM gives it back to macOS. ai-ui migrate moves
# Sage's own data to Colima, or makes a vz VM krunkit, with the copy and the
# conversion in lib/sage-runtime.sh. start and update offer it once.
OFFERS_FILE="${SAGE_CONFIG_DIR}/offers"
OFFERED=""
MOVED_FROM=""
# The runtime a move stopped sage-ai in, until its copies end.
STOPPED_IN=""

# A move that stops partway starts sage-ai again where it ran, which keeps its
# data and stays ai-ui's runtime. It runs on exit, so it must not fail.
restart_sage() {
  [[ -n "$STOPPED_IN" ]] || return 0
  if docker --context "$(runtime_context "$STOPPED_IN")" start "$CONTAINER" >/dev/null 2>&1; then
    echo "Started Sage again in $STOPPED_IN." >&2 || true
  else
    echo "Warning: Sage stays stopped in $STOPPED_IN. Start it: ai-ui start --runtime $STOPPED_IN" >&2 || true
  fi
}

# Keeps the answer to offer $1, so it is never asked again.
remember_offer() {
  mkdir -p "$SAGE_CONFIG_DIR"
  echo "ai-ui $1 $2" >> "$OFFERS_FILE"
}

# Asks once, with a terminal, whether to move Sage to Colima from Docker
# Desktop or OrbStack (ask_runtime may just have picked one, since the data
# lives there), or to make a vz VM krunkit; it acts on yes, and no changes
# nothing. A yes is kept once the move ends: one that stops partway says to
# run this again, and asks again. A vz VM without krunkit, which ai-ui cannot
# depend on (homebrew-core), gets one line on how to get it, once. A command
# given --runtime asks nothing: that runtime is a choice already. Without a
# terminal, one line says how, and nothing is kept.
offer_colima() {
  local offer say ask="" hint answer=""
  [[ "$(uname)" == Darwin && -z "$OFFERED$RUNTIME_FLAG" ]] || return 0
  OFFERED=1
  if [[ "$RUNTIME" != colima ]]; then
    runtime_installed "$RUNTIME" && runtime_installed colima || return 0
    offer=colima
    say="Sage runs in $RUNTIME. Colima is free, and its krunkit VM on Apple Silicon gives memory back to macOS. $RUNTIME keeps its copy of Sage's data."
    ask="Move Sage to Colima now?"
    hint="Sage runs in $RUNTIME. Colima is free, and its krunkit VM on Apple Silicon gives memory back to macOS. Move Sage there: ai-ui migrate"
  else
    [[ "$(uname -m)" == arm64 && "$(vm_type)" == vz ]] || return 0
    offer=krunkit
    say="Colima runs Sage on a vz VM, which keeps memory it has touched. A krunkit VM gives it back to macOS."
    ask="Make the VM krunkit now, keeping every image and volume?"
    hint="$say Convert it, keeping every image and volume: ai-ui migrate"
    if ! krunkit_ready; then
      offer=krunkit-install ask=""
      hint="$say Get krunkit, then run ai-ui migrate: $KRUNKIT_INSTALL"
    fi
  fi
  grep -q "^ai-ui $offer " "$OFFERS_FILE" 2>/dev/null && return 0
  if [[ ! -t 0 || -z "$ask" ]]; then
    echo "$hint"
    if [[ -t 0 ]]; then remember_offer "$offer" shown; fi
    return 0
  fi
  echo "$say" >&2
  read -rp "$ask ai-ui asks only this once; ai-ui migrate does it later. [y/N] " answer || true
  if [[ "$answer" != [yY]* ]]; then
    remember_offer "$offer" no
    return 0
  fi
  if [[ "$offer" == krunkit ]]; then convert_colima 1; else move_data "$RUNTIME" 0; fi
  remember_offer "$offer" yes
}

# Moves Sage's volumes from runtime $1 to Colima, then makes Colima the
# runtime; $2 is 1 for the plan alone. Each copy passes through a staged
# file, is counted on both sides and recorded. A volume Colima holds with
# data stays, unless that record vouches for it: a rerun after a stop partway
# goes on. Colima is checked before Sage stops; the copy checks the source
# after, since Sage itself uses its volumes, and a refusal there starts Sage
# again. The source keeps its copy.
move_data() {
  local from="$1" dry="$2" name copy="" listing
  if [[ "$VOLUME" == /* ]]; then
    in_home "$VOLUME" \
      || die "Sage's data is in $VOLUME, outside your home folder, the only one Colima shares with containers. Move it under $HOME and point SAGE_AI_VOLUME there, then run this again."
    echo "Sage's data is in $VOLUME on this Mac, so it needs no copy."
  fi
  if (( dry == 1 )) && ! runtime_running "$from"; then
    echo "Would start $from. It is not running, so its volumes were not listed."
    return 0
  fi
  # The copy pulls alpine, which fails on a credsStore whose helper left with
  # Docker Desktop; ensure_docker mends that only after the move.
  (( dry == 1 )) || fix_credentials "$from"
  start_engine "$from"
  # Colima is not ai-ui's runtime yet. With docker's saved context in sight,
  # not the exported one, start_engine puts it back after colima start takes it.
  (( dry == 1 )) || DOCKER_CONTEXT='' start_runtime colima
  for name in $VOLUME $TRY_VOLUME; do
    if [[ "$name" == /* ]] || ! volume_exists "$from" "$name"; then continue; fi
    if (( dry == 1 )); then
      echo "Would copy volume $name from $from to colima."
    elif volume_exists colima "$name" && measure_volume colima "$name" && (( ENTRIES > 1 )); then
      measure_volume "$from" "$name"
      [[ "$(recorded_copy "$name" "$from" colima)" == "$ENTRIES $KIB" ]] \
        || die "colima already has a volume $name with data that no copy from $from vouches for, so nothing was copied. Keep Colima's: ai-ui start --runtime colima. Or replace it with $from's: sage-runtime copy-volume $name --from $from --to colima --force"
      echo "Skipping volume $name: copied from $from before, and unchanged there since."
    else
      copy+=" $name"
    fi
  done
  (( dry == 0 )) || return 0
  echo "Stopping Sage in $from..."
  listing="$(container_mounts "$from")" || exit 1
  if [[ $'\n'"$listing" == *$'\n'"$CONTAINER"$'\t'* ]]; then STOPPED_IN="$from"; fi
  docker --context "$(runtime_context "$from")" stop "$CONTAINER" "$TRY_CONTAINER" >/dev/null 2>&1 || true
  for name in $copy; do copy_volume "$name" "$from" colima 0; done
  STOPPED_IN=""
  RUNTIME=colima DOCKER_CONTEXT=colima MOVED_FROM="$from"
  save_runtime
  # As sage-runtime use does: docker's saved context names the runtime in use.
  docker context use colima >/dev/null 2>&1 \
    || echo "Warning: docker's context stays where it was. Point it at Colima: docker context use colima" >&2
}

# The last words of a move: the way back, krunkit, and the other apps.
moved_note() {
  [[ -n "$MOVED_FROM" ]] || return 0
  echo ""
  echo "$MOVED_FROM keeps its own copy of Sage's data. Go back any time: ai-ui start --runtime $MOVED_FROM"
  # ai-ui is bound for homebrew-core, which cannot depend on krunkit's tap.
  if [[ "$(uname -m)" == arm64 ]] && ! krunkit_ready; then
    echo "krunkit is not installed, so Colima runs Sage on a vz VM. Get it, then make the VM krunkit with ai-ui migrate: $KRUNKIT_INSTALL"
  fi
  hint_convert
  echo "Other apps' data stays in $MOVED_FROM. sage-runtime migrate --from $MOVED_FROM moves it all (brew tap sage-is/apps && brew tap libkrun/krun && brew trust --tap sage-is/apps libkrun/krun && brew install sage-runtime)."
}

# Moves Sage to Colima with the tag and port sage-ai has in the source. On
# Colima itself, makes a vz VM krunkit, which restarts sage-ai on its own.
cmd_migrate() {
  local dry=0 port=$DEFAULT_PORT line="" image bound
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --yes)     shift ;;  # the conversion's messages name it; migrate acts without it
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done
  [[ "$(uname)" == Darwin ]] || die "migrate moves Sage between container runtimes on a Mac."
  OFFERED=1
  if [[ "$RUNTIME" == colima ]]; then
    if [[ "$(uname -m)" != arm64 ]]; then
      echo "Sage runs in Colima already."
      return 0
    fi
    convert_colima $(( 1 - dry ))
    return 0
  fi
  (( dry == 1 )) || start_engine "$RUNTIME"
  if runtime_running "$RUNTIME"; then
    line="$(briefly docker inspect --format '{{.Config.Image}} {{range (index .HostConfig.PortBindings "8080/tcp")}}{{.HostPort}}{{end}}' "$CONTAINER" 2>/dev/null)" || line=""
  fi
  read -r image bound <<< "$line"
  if [[ "$image" == "$IMAGE_REGISTRY:"* ]]; then IMAGE_TAG="${image#"$IMAGE_REGISTRY":}"; fi
  if [[ "$bound" =~ ^[0-9]+$ ]]; then port="$bound"; fi
  move_data "$RUNTIME" "$dry"
  if (( dry == 1 )); then
    echo "Would stop Sage in $RUNTIME, make colima ai-ui's runtime and start $IMAGE_REGISTRY:$IMAGE_TAG there on port $port. $RUNTIME keeps its copy."
    echo "Dry run: nothing changed. Move: ai-ui migrate"
    return 0
  fi
  cmd_start --port "$port" --tag "$IMAGE_TAG"
}

cmd_logs() {
  docker logs -f "$CONTAINER"
}

cmd_open() {
  local port
  port=$(docker port "$CONTAINER" 8080 2>/dev/null | head -1 | cut -d: -f2)
  if [[ -z "$port" ]]; then
    echo "Container is not running. Start it first with: ai-ui start"
    exit 1
  fi
  local url="http://localhost:$port"
  case "$(uname)" in
    Darwin) open "$url" ;;
    *)      xdg-open "$url" 2>/dev/null || echo "Open $url in your browser." ;;
  esac
}

cmd_status() {
  docker inspect --format='Status: {{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "Container is not running."
  local port
  port=$(docker port "$CONTAINER" 8080 2>/dev/null | head -1 | cut -d: -f2)
  if [[ -n "$port" ]]; then
    echo "URL: http://localhost:$port"
  fi
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

command="$1"; shift

# --runtime NAME works with every command: take it out before the command reads its own options.
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime)
      [[ $# -ge 2 ]] || { echo "Error: --runtime needs one of: $RUNTIMES"; exit 1; }
      RUNTIME_FLAG="$2"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
# macOS runs bash 3.2, where "${args[@]}" on an empty array trips `set -u`.
set -- ${args[@]+"${args[@]}"}

if [[ "$(uname)" == Darwin ]]; then
  case "$command" in
    start|try|update|dev)               select_runtime ask ;;
    stop|logs|open|status|nuke|migrate) select_runtime ;;
  esac
fi

case "$command" in
  start)   cmd_start "$@" ;;
  stop)    cmd_stop ;;
  try)     cmd_try "$@" ;;
  update)  cmd_update "$@" ;;
  dev)     cmd_dev "$@" ;;
  migrate) cmd_migrate "$@" ;;
  logs)    cmd_logs ;;
  open)    cmd_open ;;
  status)  cmd_status ;;
  nuke)    cmd_nuke "$@" ;;
  version|-v|--version) cmd_version ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $command"; usage; exit 1 ;;
esac
