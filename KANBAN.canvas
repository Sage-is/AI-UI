      "y": 5730
    },
    {
      "file_path": "charts/chat-path-restructure/TODO.md",
      "height": 80,
      "id": "88451a1a723f2775",
      "line_num": 127,
      "source": "todo_md",
      "tags": [
        "#task"
      ],
      "text": "**Tier 1: move the module-level functions into the package**\n`#task`\n`charts/chat-path-restructure/TODO.md:L127`",
      "type": "text",
      "width": 280,
      "x": 360,
      "y": 5820
    },
    {
      "file_path": "charts/chat-path-restructure/TODO.md",
      "height": 80,
      "id": "a9d5a0b033db632c",
      "line_num": 145,
      "source": "todo_md",
