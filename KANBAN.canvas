        },
        {
          "checked": false,
          "line_num": 225,
          "tags": [],
          "text": "The fix (`langchain-core==1.2.22`) needs `langchain-core<1.0.0` dropped, which both pinned sprig-side packages require (`langchain==0.3.30`, `langchain-community==0.3.27`, `app/backend/requirements.txt:51-56`)."
        },
