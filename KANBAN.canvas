      "width": 280,
      "x": 360,
      "y": 5910
    },
    {
      "file_path": "charts/chat-path-restructure/TODO.md",
      "height": 80,
      "id": "278eb8a7cefce39a",
      "line_num": 166,
      "source": "todo_md",
