# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.bandit.yaml
!/.dockerignore
!.*.example
!/.gitattributes
!/.gitignore
# No !/.githooks/** here, deliberately. There is ONE hook mechanism: the
# pre-commit framework, installed into .git/hooks by `make install_hooks`.
# .githooks/ existed alongside it and `git config core.hooksPath .githooks`
# redirected git away from .git/hooks, silently disabling all five stages.
# Tracking the directory would distribute that trap to every clone.
!/.gitleaks.toml
!/.pre-commit-config.yaml
!/.trivyignore
!.todoscope-exclude.csv
!.obsidian/
!.obsidian/**
# ...except per-machine state. app.json, appearance.json, hotkeys.json,
# core-plugins.json, snippets/ and themes/ are shared vault CONFIG and belong in
# git. workspace.json is open panes, scroll positions and lastOpenFiles, which
# Obsidian rewrites continuously — 12 of 394 commits touched it, one with a
# subject line about lastOpenFiles. SyncThing already replicates the vault, so
# tracking it here put two mechanisms on one file and produced the
# sync-conflict-*.json wreckage.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
*.sync-conflict-*
!/.semgrep/
!/.semgrep/**
!/app/.eslintrc.cjs
!/app/.prettierrc
!/app/backend/.dockerignore
!/app/backend/.gitignore

# Large backup tgz
*.tgz

# Tracked outside git. These trees carry private working notes and are
# mirrored by other means — they are durable records, not scratch. Git is
# simply not the system of record for them.
# (.claude/ is already denied by the `.*` rule at the top of this file.)
/docs/decisions/
/charts/
/scripts/gates/*/baseline.json

node_modules
/app/.svelte-kit
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# complexipy drops this beside the cwd when run by hand. The gate writes it to a
# temp directory instead — the baseline it ratchets against is
# scripts/gates/cognitive-complexity/baseline.json, kept outside git like the
# other gate baselines (see the block above).
# (.complexipy_cache/ and .ruff_cache/ are already denied by the `.*` rule above.)
complexipy-snapshot.json
complexipy-results.json

# Pyodide distribution
app/static/pyodide/*
!app/static/pyodide/pyodide-lock.json

# Distribution
build/

# Unit test / coverage reports
htmlcov/
coverage.xml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage
*.lcov

# cypress artifacts (local-only run evidence — videos, failure screenshots,
# optional REPORT=1 junit XML; no Cypress Cloud anywhere)
cypress/videos
cypress/screenshots
cypress/reports


# DB snapshots for upgrade testing (large binary files, synced via SyncThing/B2)
# Production data snapshots: real user chats/uploads/vectors. NEVER commit.
# (The upgrade gate reads them read-only and works on volume copies.)
tools/db_snapshots/

# Outreach drafts (private — not for the public repo)
# Keep README.md tracked so the folder's purpose is documented in git
docs/outreach/*
!docs/outreach/README.md

# Cypress test artifacts (local-only run evidence — videos, failure screenshots,
# optional REPORT=1 junit XML; no Cypress Cloud anywhere)
app/cypress/videos
app/cypress/screenshots
app/cypress/reports
app/cypress/perf-resources.json
app/cypress/perf-plain.json
app/cypress/perf-workshop.json
app/cypress/perf-routes.json
app/cypress/boot-waterfall-timing.json

